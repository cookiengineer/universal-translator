package() {
  local models_dir="$pkgdir/usr/share/universal-translator/models"
  install -dm755 "$models_dir"

  for archive in "$srcdir"/*.tar.gz; do
    local short_name
    short_name="$(basename "$archive" .tar.gz)"

    local destination="$models_dir/$short_name"
    install -dm755 "$destination"
    bsdtar -xf "$archive" -C "$destination" --strip-components=1
  done
}
